{
    "name": "toastify-all",
    "version": "1.0.0",
    "description": "Universal, modern toast notification engine for all JavaScript frameworks and platforms (React, Vue, Angular, React Native, Next.js, Vanilla)",
    "main": "dist/index.js",
    "module": "dist/index.esm.js",
    "unpkg": "dist/index.umd.js",
    "jsdelivr": "dist/index.umd.js",
    "types": "dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/index.esm.js",
            "require": "./dist/index.js",
            "default": "./dist/index.esm.js"
        },
        "./react": {
            "types": "./dist/react/index.d.ts",
            "import": "./dist/react/index.esm.js",
            "require": "./dist/react/index.js",
            "default": "./dist/react/index.esm.js"
        },
        "./vue": {
            "types": "./dist/vue/index.d.ts",
            "import": "./dist/vue/index.esm.js",
            "require": "./dist/vue/index.js",
            "default": "./dist/vue/index.esm.js"
        },
        "./angular": {
            "types": "./dist/angular/index.d.ts",
            "import": "./dist/angular/index.esm.js",
            "require": "./dist/angular/index.js",
            "default": "./dist/angular/index.esm.js"
        },
        "./react-native": {
            "types": "./dist/react-native/index.d.ts",
            "import": "./dist/react-native/index.esm.js",
            "require": "./dist/react-native/index.js",
            "default": "./dist/react-native/index.esm.js"
        },
        "./package.json": "./package.json"
    },
    "typesVersions": {
        "*": {
            "react": [
                "dist/react/index.d.ts"
            ],
            "vue": [
                "dist/vue/index.d.ts"
            ],
            "angular": [
                "dist/angular/index.d.ts"
            ],
            "react-native": [
                "dist/react-native/index.d.ts"
            ],
            "*": [
                "dist/types/*"
            ]
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "clean": "rimraf dist",
        "build": "npm run clean && npm run build:main && npm run build:types",
        "build:main": "rollup -c",
        "build:types": "npm run copy:types",
        "copy:types": "npm run copy:core-types && npm run copy:react-types && npm run copy:vue-types && npm run copy:angular-types && npm run copy:rn-types",
        "copy:core-types": "copyfiles -f src/types/index.d.ts dist/types",
        "copy:react-types": "copyfiles -f src/react/index.d.ts dist/react",
        "copy:vue-types": "copyfiles -f src/vue/index.d.ts dist/vue",
        "copy:angular-types": "copyfiles -f src/angular/index.d.ts dist/angular",
        "copy:rn-types": "copyfiles -f src/react-native/index.d.ts dist/react-native",
        "dev": "rollup -c -w",
        "test": "jest",
        "lint": "eslint src/**/*.{js,jsx,ts} --fix",
        "prepare": "npm run build"
    },
    "keywords": [
        "toastify-all",
        "toastify",
        "react-toastify",
        "toast",
        "notification",
        "notifications",
        "alert",
        "react",
        "nextjs",
        "vue",
        "vue3",
        "angular",
        "react-native",
        "universal",
        "cross-platform",
        "sonner",
        "javascript",
        "typescript"
    ],
    "author": "Veeresh <veeresha3993@gmail.com>",
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "https://github.com/VeereshMaps/toastify-all.git"
    },
    "bugs": {
        "url": "https://github.com/VeereshMaps/toastify-all/issues"
    },
    "homepage": "https://veereshmaps.github.io/toastify-all",
    "devDependencies": {
        "@angular/core": "^17.0.0",
        "@babel/core": "^7.22.0",
        "@babel/plugin-proposal-class-properties": "^7.18.6",
        "@babel/plugin-proposal-decorators": "^7.28.0",
        "@babel/plugin-transform-class-properties": "^7.22.5",
        "@babel/preset-env": "^7.22.0",
        "@babel/preset-react": "^7.22.0",
        "@babel/preset-typescript": "^7.22.0",
        "@rollup/plugin-babel": "^6.0.0",
        "@rollup/plugin-commonjs": "^25.0.8",
        "@rollup/plugin-node-resolve": "^15.3.1",
        "@rollup/plugin-typescript": "^12.1.4",
        "@testing-library/jest-dom": "^5.16.0",
        "@testing-library/react": "^13.4.0",
        "@types/jest": "^29.5.0",
        "@types/react": "^18.2.0",
        "copyfiles": "^2.4.1",
        "eslint": "^8.45.0",
        "jest": "^29.6.0",
        "jest-environment-jsdom": "^29.7.0",
        "react": "^18.0.0",
        "rimraf": "^5.0.0",
        "rollup": "^3.26.0",
        "typescript": "^5.9.2",
        "vue": "^3.0.0",
        "zone.js": "^0.14.0"
    },
    "peerDependencies": {
        "@angular/core": ">=12.0.0",
        "react": ">=16.8.0",
        "react-native": ">=0.60.0",
        "vue": ">=3.0.0"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        },
        "vue": {
            "optional": true
        },
        "@angular/core": {
            "optional": true
        },
        "react-native": {
            "optional": true
        }
    }
}
